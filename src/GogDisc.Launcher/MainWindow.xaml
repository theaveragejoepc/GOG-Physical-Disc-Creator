<Window x:Class="GogDisc.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="529" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Foreground="#ECEEF4"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        SizeChanged="Window_SizeChanged">
    <Border Background="#11151D" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.32"/>
        </Border.Effect>
        <Border.Clip>
            <RectangleGeometry x:Name="WindowClip" Rect="0,0,505,700" RadiusX="14" RadiusY="14"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeroRow" Height="312"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Hero" MouseLeftButtonDown="Hero_MouseLeftButtonDown">
                <Grid ClipToBounds="True">
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#18000000" Offset="0"/>
                            <GradientStop Color="#1011151D" Offset="0.45"/>
                            <GradientStop Color="#F411151D" Offset="0.84"/>
                            <GradientStop Color="#FF11151D" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Button Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,16,0" Style="{StaticResource SecondaryButton}" Padding="0" Click="Close_Click">
                    <Path Width="14" Height="14" Data="M 1,1 L 13,13 M 13,1 L 1,13"
                          Stroke="#ECEEF4" StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Stretch="None"/>
                </Button>

                <Button x:Name="EjectButton" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,16,58,0" Style="{StaticResource SecondaryButton}" Padding="0" Click="Eject_Click"
                        ToolTip="Eject disc">
                    <Grid Width="16" Height="16">
                        <Path Data="M 2,10 L 8,3 L 14,10 Z" Stroke="#ECEEF4" Fill="Transparent"
                              StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        <Path Data="M 2,13 L 14,13" Stroke="#ECEEF4" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Button>

                <Button x:Name="BackButton" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="58,16,0,0" Style="{StaticResource SecondaryButton}" Padding="0" Click="Back_Click"
                        ToolTip="Back to collection" Visibility="Collapsed">
                    <Path Data="M 7,1 L 1,7 L 7,13" Stroke="#ECEEF4" StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>

                <Button x:Name="OverflowButton" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16,16,0,0" Style="{StaticResource SecondaryButton}" Padding="0"
                        Click="Overflow_Click" ToolTip="More options">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem x:Name="KeepOpenMenuItem" Header="Keep launcher open" IsCheckable="True"
                                      StaysOpenOnClick="True" Click="KeepOpenMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="3" Height="3" Fill="#ECEEF4"/>
                        <Ellipse Width="3" Height="3" Fill="#ECEEF4" Margin="3,0"/>
                        <Ellipse Width="3" Height="3" Fill="#ECEEF4"/>
                    </StackPanel>
                </Button>

                <Border x:Name="HeroCover" Width="152" Height="211" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="24,80,0,0" CornerRadius="9" Background="#252C39">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="17" ShadowDepth="7" Opacity="0.26"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock x:Name="CoverPlaceholder" Text="COVER ART" Foreground="#B0B8C8"
                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="CoverImage" Width="152" Height="211" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,152,211" RadiusX="9" RadiusY="9"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel x:Name="HeroTitle" Margin="192,0,24,24" VerticalAlignment="Bottom">
                    <!-- LineHeight pinned so MaxHeight is an exact two-line cap; the ellipsis lands on line 2. -->
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold"
                               LineHeight="32" LineStackingStrategy="BlockLineHeight" MaxHeight="64"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SizeText" FontSize="14" Foreground="#B0B8C8" Margin="0,6,0,0"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="RequiredSpaceText" FontSize="14" Foreground="#B0B8C8" Margin="0,2,0,0"
                               LineHeight="19" LineStackingStrategy="BlockLineHeight" MaxHeight="38"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly" Focusable="False" ScrollChanged="ContentScroller_ScrollChanged">
            <Grid x:Name="ScrollableContent" Margin="24,24,24,8">
                <StackPanel x:Name="CollectionPanel" Visibility="Collapsed">
                    <StackPanel x:Name="InstallAllSection" Style="{StaticResource Section}">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Install entire collection" Style="{StaticResource CardText}"/>
                                    <TextBlock Text="This will run through each game installer individually." Style="{StaticResource CardSubtext}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="InstallAllToggle" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Style="{StaticResource KeyToggle}" Checked="InstallAll_Changed" Unchecked="InstallAll_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CollectionDestinationSection" Style="{StaticResource Section}">
                        <TextBlock Text="We’ll install each game to a new folder in this location:" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CollectionDestinationText" Style="{StaticResource CardText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CollectionFreeSpaceText" Style="{StaticResource CardSubtext}" Foreground="#B0B8C8"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Margin="16,0,0,0"
                                        Click="ChooseInstallLocation_Click" ToolTip="Choose installation location">
                                    <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#ECEEF4" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ReadySection" Style="{StaticResource Section}">
                        <TextBlock Text="Collection games — D-pad / left stick: move · A: select · B: back" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource ListCard}">
                            <ItemsControl x:Name="ReadyList" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
            <Border Width="208" Margin="7" Background="#202631" CornerRadius="8" BorderBrush="#394253" BorderThickness="1">
                <StackPanel>
                    <Image Source="{Binding Cover}" Height="230" Stretch="UniformToFill" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="10,10,10,0" TextWrapping="Wrap" Height="40" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Size}" Foreground="#B0B8C8" Margin="10,0,10,0"/>
                    <UniformGrid Columns="2" Margin="8,8,8,4" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Uninstall" Tag="{Binding}" Click="CollectionUninstall_Click" Style="{StaticResource LinkButton}" IsEnabled="{Binding CanUninstall}"/>
                    <Button Content="Play" Tag="{Binding}" Click="CollectionPlay_Click" Style="{StaticResource PrimaryButton}" Height="36"/>
                </UniformGrid>
                <Button Content="Install / details" Tag="{Binding}" Click="CollectionGame_Click" Style="{StaticResource PrimaryButton}" Margin="8" Height="36" Visibility="{Binding NeedsInstall, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Extras" Tag="{Binding}" Click="CollectionExtras_Click" Style="{StaticResource LinkButton}" Margin="8,0,8,8" Visibility="{Binding HasExtras, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>

                <StackPanel x:Name="DefaultPanel">
                    <StackPanel x:Name="KeyOptionsSection" Visibility="Collapsed" Style="{StaticResource Section}">
                        <TextBlock Text="Install from GOG or download an offline backup" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Keep an offline backup" Style="{StaticResource CardText}"/>
                                    <TextBlock Style="{StaticResource CardSubtext}"
                                               Text="Downloads the GOG offline installers, keeps them, and installs from them. Needs room for both the backup and the game."/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" x:Name="DownloadOfflineBackupBox" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Style="{StaticResource KeyToggle}" Checked="DownloadOfflineBackup_Changed" Unchecked="DownloadOfflineBackup_Changed"/>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="KeyBackupLocationSection" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="We’ll keep the offline backup here:" Style="{StaticResource SectionLabel}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="KeyBackupLocationText" Style="{StaticResource CardText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="KeyBackupFreeSpaceText" Style="{StaticResource CardSubtext}" Foreground="#B0B8C8"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Margin="16,0,0,0"
                                            Click="ChooseBackupLocation_Click" ToolTip="Choose where to keep the offline backup">
                                        <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#ECEEF4" StrokeThickness="1.7"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="These installers stay on your disk after installing, so you can reinstall this exact build later without GOG. Uninstalling the game does not remove them. Bonus content is downloaded separately with the Extras button."
                                       Style="{StaticResource SectionHint}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="KeyDestinationSeparator" Visibility="Collapsed" Height="1" Background="#394253" Margin="-24,0,-24,16"/>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock x:Name="DestinationLabel" Text="We’ll install this game to a new folder in this location:" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DestinationText" Style="{StaticResource CardText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="FreeSpaceText" Style="{StaticResource CardSubtext}" Foreground="#B0B8C8"/>
                                </StackPanel>
                                <Button x:Name="ChooseDestinationButton" Grid.Column="1" Style="{StaticResource CardActionButton}" Margin="16,0,0,0"
                                        Click="ChooseInstallLocation_Click" ToolTip="Choose installation location">
                                    <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#ECEEF4" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TemporaryLocationSection" Style="{StaticResource Section}">
                        <TextBlock Text="Temporary GOG disc backup location:" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TemporaryLocationText" Style="{StaticResource CardText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TemporaryFreeSpaceText" Style="{StaticResource CardSubtext}" Foreground="#B0B8C8"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Margin="16,0,0,0"
                                        Click="ChooseTemporaryLocation_Click" ToolTip="Choose temporary backup location">
                                    <Path Data="M 1,2 L 7,8 L 13,2" Stroke="#ECEEF4" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="Disc installation files are copied and verified here before setup starts. Opening optical media may take a minute; this backup is removed after installation completes."
                                   Style="{StaticResource SectionHint}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="InstalledPanel" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Current installation:" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="InstalledLocationText" Style="{StaticResource CardText}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="InstalledFreeSpaceText" Style="{StaticResource CardSubtext}" Foreground="#B0B8C8"/>
                                </StackPanel>
                                <Button x:Name="UninstallButton" Grid.Column="1" Content="Uninstall" Margin="16,0,0,0"
                                        VerticalAlignment="Center" Style="{StaticResource LinkButton}" Click="Uninstall_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <StackPanel x:Name="AuthenticationSection" Visibility="Collapsed" Style="{StaticResource Section}">
                        <TextBlock Text="Sign in in your browser, then paste the final GOG page URL (or its code) here. This app never receives your password:"
                                   Style="{StaticResource SectionLabel}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="AuthenticationCodeText" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"
                                         ToolTip="Paste the final GOG page URL or authorization code"/>
                                <Button x:Name="AuthenticationContinueButton" Grid.Column="1" Content="Continue" Margin="16,0,0,0"
                                        VerticalAlignment="Center" Style="{StaticResource LinkButton}" Click="AuthenticationContinue_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock x:Name="EstimateText" Text="Estimated time remaining: Calculating…" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center">
                                <Grid x:Name="DiscLabelsGrid" Margin="0,0,0,10"/>
                                <ProgressBar x:Name="CopyProgress" Minimum="0" Maximum="100"
                                             Style="{StaticResource DiscProgress}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </ScrollViewer>
            <Border x:Name="KeyScrollBoundary" Grid.Row="1" Panel.ZIndex="4" Height="1" VerticalAlignment="Top"
                    Margin="0,0,14,0" Visibility="Collapsed" IsHitTestVisible="False" Background="#394253"/>

            <Border x:Name="FooterSeparator" Grid.Row="2" Background="#394253"/>

            <Grid x:Name="Footer" Grid.Row="3" Background="#181E29">
                <Grid Margin="24">
                <Grid x:Name="CollectionActions" Visibility="Collapsed">
                    <Button x:Name="InstallCollectionButton" Content="Install games" Style="{StaticResource PrimaryButton}"
                            Click="InstallCollection_Click"/>
                </Grid>

                <Grid x:Name="DefaultActions">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}"
                            Click="Install_Click"/>
                    <Button x:Name="PreInstallExtrasButton" Grid.Column="2" Content="Extras"
                            Style="{StaticResource SecondaryButton}" Click="Extras_Click"/>
                </Grid>

                <Grid x:Name="InstalledActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButton}" Click="Play_Click"/>
                    <Button x:Name="ExtrasButton" Grid.Column="2" Content="Extras" Style="{StaticResource SecondaryButton}"
                            Click="Extras_Click"/>
                </Grid>

                <Grid x:Name="OperationActions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Button x:Name="OperationStatusButton" Content="Installing…" IsHitTestVisible="False"
                            Focusable="False" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click"/>
                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
